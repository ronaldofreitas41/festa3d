# Opcional: chave da Meshy (https://www.meshy.ai) para converter fotos em 3D de verdade com IA.
# Sem chave, o site usa o modo "Recorte 3D" (foto sem fundo em pe no cenario).
MESHY_API_KEY=

# Supabase (banco e arquivos). Rode supabase/schema.sql no SQL Editor uma vez.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta, usada so no servidor (rotas /api). Nunca use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SECRET_KEY=

# IA de 3D gratuita (TRELLIS no Hugging Face). Funciona sem token, mas a cota diaria e minima.
# Token gratuito: https://huggingface.co/settings/tokens (tipo "Read").
HF_TOKEN=
# Use AI_PROVIDER=cutout para desligar a IA e usar so o recorte da foto.
